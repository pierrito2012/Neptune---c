<?xml version="1.0" encoding="UTF-8"?>
<language id="neptune" name="Neptune C--" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/x-neptune;application/x-neptune</property>
    <property name="globs">*.nep</property>
    <property name="line-comment-start">#</property>
  </metadata>
  <styles>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
    <style id="type" name="Type" map-to="def:type"/>
    <style id="function" name="Function" map-to="def:function"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="number" name="Number" map-to="def:number"/>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="operator" name="Operator" map-to="def:operator"/>
    <style id="constant" name="Constant" map-to="def:constant"/>
  </styles>
  <definitions>
    <context id="neptune">
      <include>
        <context id="comment" style-ref="comment">
          <start>#</start>
          <end>$</end>
        </context>
        <context id="string" style-ref="string">
          <start>"</start>
          <end>"</end>
        </context>
        <context id="number" style-ref="number">
          <match>\b[0-9]+(\.[0-9]+)?\b</match>
        </context>
        <context id="boolean" style-ref="constant">
          <keyword>true</keyword>
          <keyword>false</keyword>
        </context>
        <context id="declarations" style-ref="type">
          <keyword>var</keyword>
          <keyword>vartable</keyword>
          <keyword>struct</keyword>
        </context>
        <context id="control" style-ref="keyword">
          <keyword>if</keyword>
          <keyword>else</keyword>
          <keyword>while</keyword>
          <keyword>for</keyword>
          <keyword>end</keyword>
          <keyword>do</keyword>
          <keyword>return</keyword>
          <keyword>include</keyword>
        </context>
        <context id="functions" style-ref="function">
          <keyword>efunc</keyword>
          <keyword>echo</keyword>
          <keyword>cin</keyword>
        </context>
        <context id="function-call" style-ref="function">
          <match>\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()</match>
        </context>
        <context id="operator" style-ref="operator">
          <match>==|!=|&gt;=|&lt;=|[+*/%=&lt;&gt;-]</match>
        </context>
      </include>
    </context>
  </definitions>
</language>
